---
import DetailLayout from '../../layouts/DetailLayout.astro';
import StarSection from '../../components/StarSection.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const kpis = [
  { label: "Board Consolidation", value: "Unified", sub: "Single-pane opportunity intake" },
  { label: "Fit Evaluation", value: "Real-Time", sub: "Role vs profile match analysis" },
  { label: "Pipeline Tracking", value: "Centralized", sub: "Status & stage management" },
  { label: "Efficiency Gain", value: "High", sub: "Streamlined search workflow" }
];

const tools = [
  "JavaScript",
  "Node.js",
  "Express",
  "Data Aggregation",
  "PDF Engine",
  "HTML5 & CSS3"
];

const aggregatorSteps = [
  { step: "01", title: "Opportunity Aggregation", desc: "Consolidates listings from diverse career platforms into a structured, single-pane intake queue." },
  { step: "02", title: "Role-Profile Fit Evaluation", desc: "Analyzes job posting requirements against master qualifications to highlight strong alignment." },
  { step: "03", title: "Tailored Profile Export", desc: "Generates clean, focused CV exports dynamically aligned with the role's primary focus." },
  { step: "04", title: "Pipeline Management", desc: "Tracks application stages, interview progress, and communication checkpoints in one central CRM." }
];
---

<DetailLayout
  title="Job Search Platform Aggregator & Opportunity Hub"
  subtitle="A centralized career management platform designed to aggregate multi-source job postings, evaluate role-to-profile alignment, and streamline opportunity tracking into a unified dashboard."
  category="Data Consolidation & Opportunity Intelligence"
  tag="Custom Tool"
  role="Full-Stack Developer & Product Owner"
  timeline="2025 – 2026"
  tools={tools}
  kpis={kpis}
  backLink="/#custom-tools"
  backText="Back to Custom tools"
>

  <!-- SITUATION -->
  <StarSection type="situation" title="The Fragmented Job Search Landscape">
    <p>
      Searching for specialized marketing and technical leadership roles across international markets is traditionally fragmented across dozens of disconnected platforms—including LinkedIn, regional European job portals, and specialized ATS boards. Reviewing roles across multiple browser tabs makes it difficult to maintain a coherent search strategy, leads to duplicate reviews, and obscures application history.
    </p>
    <p>
      Additionally, evaluating whether a given opportunity genuinely matches core skills (Performance Marketing vs. Technical SEO vs. Omnichannel Operations) requires rapid, objective comparison against candidate qualifications.
    </p>
  </StarSection>

  <!-- TASK -->
  <StarSection type="task" title="Project Objectives & Platform Scope">
    <p class="font-medium text-slate-900 dark:text-slate-100">
      Build an integrated career opportunity dashboard with four central features:
    </p>
    <ul class="list-disc pl-5 space-y-2 mt-2">
      <li><strong>Unified Opportunity Queue:</strong> Aggregate and organize target job listings from disparate sources into a clean, searchable internal feed.</li>
      <li><strong>Role Fit Evaluation:</strong> Provide instant comparison between posted job requirements and candidate expertise to prioritize top opportunities.</li>
      <li><strong>Dynamic Profile Customization:</strong> Maintain a master modular CV dataset with real-time section toggles to compile clean, role-tailored PDF summaries.</li>
      <li><strong>Structured Application CRM:</strong> Provide full lifecycle tracking for applications, interviews, contacts, and follow-up milestones.</li>
    </ul>
  </StarSection>

  <!-- SYSTEM FLOW DIAGRAM -->
  <FlowDiagram title="Consolidated Career Opportunity Workflow" steps={aggregatorSteps} />

  <!-- SCREENSHOT SHOWCASE -->
  <div class="my-10 space-y-8 not-prose">
    <div class="space-y-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Platform Dashboard Interface
      </h3>
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-xl bg-slate-950">
        <img
          src={`${base}/images/projects/job-filler/dashboard-overview.png`}
          alt="Job Search Platform Aggregator Dashboard"
          class="w-full h-auto object-cover"
        />
        <div class="p-4 bg-white dark:bg-[#0f172a] border-t border-slate-100 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400">
          <strong>Centralized Opportunity Hub:</strong> Master profile manager with modular section toggles, application pipeline status tracking, and dynamic PDF export controls.
        </div>
      </div>
    </div>
  </div>

  <!-- ACTION -->
  <StarSection type="action" title="Architecture & Functional Implementation">
    <div class="space-y-5">
      <div>
        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-1">1. Multi-Source Opportunity Aggregation Engine</h4>
        <p>
          Constructed a lightweight backend service that ingests and standardizes postings across target markets. Each posting is normalized with standardized fields: company tier, seniority, key required competencies, location, and salary benchmarks.
        </p>
      </div>

      <div>
        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-1">2. Requirement-to-Profile Match Scoring</h4>
        <p>
          Integrated a semantic evaluation engine that analyzes job specifications against the user's verified track record. Postings are scored and categorized into priority tiers, allowing instant identification of the highest-relevance positions.
        </p>
      </div>

      <div>
        <h4 class="text-base font-bold text-slate-900 dark:text-white mb-1">3. Modular CV Customization & Export</h4>
        <p>
          Built a section-based resume editor driven by structured JSON. The platform allows instant toggling of role-specific highlights (e.g. emphasizing performance marketing ad spend vs technical SEO audits) before compiling an export-ready PDF.
        </p>
      </div>
    </div>
  </StarSection>

  <!-- RESULT -->
  <StarSection type="result" title="Operational Impact & Search Discipline">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4 not-prose">
      <div class="p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800">
        <div class="text-xs uppercase font-bold text-emerald-600 dark:text-emerald-400">Search Efficiency</div>
        <div class="text-base font-bold text-slate-900 dark:text-white mt-1">Unified Single-Pane Workflow</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
          Eliminated tab clutter and disjointed notes by centralizing listings, notes, and deadlines into a single dashboard.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800">
        <div class="text-xs uppercase font-bold text-emerald-600 dark:text-emerald-400">Targeted Accuracy</div>
        <div class="text-base font-bold text-slate-900 dark:text-white mt-1">Objective Role Prioritization</div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
          Focuses attention on positions with the strongest qualification overlap, ensuring tailored applications with zero fatigue.
        </p>
      </div>
    </div>
  </StarSection>

</DetailLayout>
