---
import Layout from '../layouts/Layout.astro';
import BentoGreeting from '../components/bento/BentoGreeting.astro';
import BentoMetrics from '../components/bento/BentoMetrics.astro';
import BentoCaseStudies from '../components/bento/BentoCaseStudies.astro';
import BentoCustomTools from '../components/bento/BentoCustomTools.astro';
import BentoMarTechStack from '../components/bento/BentoMarTechStack.astro';
import BentoCredentials from '../components/bento/BentoCredentials.astro';
import cvData from '../data/cv.json';

const { basics } = cvData;
---

<Layout
  title="Doruk Doğan | Performance Marketing & Technical Web Operations Specialist"
  description="Personal portfolio of Doruk Doğan — Enterprise Performance Marketing, Technical SEO, and Custom Automation Software."
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 space-y-4">
    
    <!-- Greeting with Reserved Portrait Frame -->
    <BentoGreeting />

    <!-- 4 Key Numbers -->
    <BentoMetrics />

    <!-- Past Work / Case Studies -->
    <BentoCaseStudies />

    <!-- Custom Software Tools -->
    <BentoCustomTools />

    <!-- Career Timeline & Experience -->
    <BentoMarTechStack />

    <!-- Qualifications & Categorized Credentials -->
    <BentoCredentials />

    <!-- Ultra-Minimal Direct Contact (Zero Emojis, No Phone, No Form) -->
    <section id="contact" class="py-12 sm:py-16 scroll-mt-16">
      <div class="space-y-4">
        
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Contact
        </h2>
        
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl">
          Available for Senior Growth, Performance Marketing, and Web Operations mandates across Europe and remote.
        </p>

        <!-- Horizontal Direct Contact Coordinates -->
        <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm font-mono">
          <a
            href={`mailto:${basics.email}`}
            class="text-slate-900 dark:text-white font-semibold hover:text-emerald-600 dark:hover:text-emerald-400 underline underline-offset-4"
          >
            {basics.email}
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={basics.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 underline underline-offset-4"
          >
            LinkedIn
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <span class="text-slate-500 dark:text-slate-400">
            {basics.location}
          </span>
        </div>

      </div>
    </section>

  </main>
</Layout>
