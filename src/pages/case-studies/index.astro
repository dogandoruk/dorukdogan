---
import Layout from '../../layouts/Layout.astro';
import DossierWorkRow from '../../components/DossierWorkRow.astro';
import caseStudies from '../../data/case-studies.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => n.toString().padStart(2, '0');
---

<Layout
  title="Past work | Doruk Doğan"
  description="Selected client deliverables spanning borderless web design, B2B consulting platforms, multi-market paid media operations, and enterprise technical SEO."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-12">
    
    <!-- Header -->
    <div class="space-y-4 border-b border-slate-900 dark:border-white pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-semibold">
        <span>Client Deliverables & Web Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Past work
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Structured breakdowns of high-ticket web design, commercial B2B consulting platforms, multi-market paid media operations, and enterprise technical SEO delivered for international brands.
      </p>
    </div>

    <!-- Editorial Rows (Zero cards, clean hairline borders) -->
    <div class="divide-y divide-slate-200/80 dark:divide-slate-800/80">
      {caseStudies.map((study, idx) => (
        <DossierWorkRow
          index={pad(idx + 1)}
          title={study.title}
          category={study.category}
          timeline={study.timeline}
          summary={study.summary}
          kpis={study.kpis}
          tools={study.tools}
          url={study.url}
          outboundUrl={'outboundUrl' in study ? (study as any).outboundUrl : undefined}
          repoUrl={'repoUrl' in study ? (study as any).repoUrl : undefined}
          image={'image' in study ? (study as any).image : undefined}
        />
      ))}
    </div>

    <!-- Note on confidentiality -->
    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 text-xs text-slate-500 dark:text-slate-400">
      <strong>Confidentiality Notice:</strong> Specific internal financial budgets and raw customer identifiers have been normalized to respect client non-disclosure agreements. Methodologies and operational architectures reflect authentic enterprise delivery.
    </div>

  </div>
</Layout>
