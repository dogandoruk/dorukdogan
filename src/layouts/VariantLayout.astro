---
import VariantNavbar from '../components/variant/VariantNavbar.astro';
import VariantFooter from '../components/variant/VariantFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Doruk Doğan | Dark Staging Variant",
  description = "Dark Mode staging portfolio of Doruk Doğan featuring in-place expandable drawers, custom AI tooling, and enterprise marketing history.",
  image = "/images/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dogandoruk.github.io/dorukdogan');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Modern Web Guidance: Deep Dark Mode color-scheme -->
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Details content smooth intrinsic size animation (interpolate-size: allow-keywords on :root) -->
    <style is:global>
      ::details-content {
        transition: block-size 0.35s ease, content-visibility 0.35s allow-discrete;
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-[#090D16] text-slate-100 antialiased selection:bg-emerald-500/20 selection:text-emerald-300">
    <VariantNavbar />
    <main class="flex-grow">
      <slot />
    </main>
    <VariantFooter />
  </body>
</html>
