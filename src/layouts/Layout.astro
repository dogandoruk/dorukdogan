---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Doruk Doğan | Digital Marketing & Growth Specialist",
  description = "Portfolio of Doruk Doğan — Enterprise Performance Marketing, Technical SEO, and AI Tooling Builder.",
  image = "/images/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dogandoruk.github.io/dorukdogan');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Schema.org Person metadata
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Doruk Doğan",
  "jobTitle": "Digital Marketing & Growth Specialist",
  "url": canonicalURL.href,
  "sameAs": [
    "https://www.linkedin.com/in/dorukdogan"
  ],
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Kadir Has University"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Koç University"
    }
  ],
  "knowsAbout": [
    "Performance Marketing",
    "Technical SEO",
    "Adobe Experience Manager",
    "Adobe Target",
    "Smartly.io",
    "FastAPI",
    "Python",
    "Artificial Intelligence"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Modern Web Guidance: Declare color-scheme early for native scrollbars and controls -->
    <meta name="color-scheme" content="light dark" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : `${canonicalURL.origin}${base}${image}`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image.startsWith('http') ? image : `${canonicalURL.origin}${base}${image}`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Anti-Flash Theme Script (Defaults to 'light' for clean, crisp editorial experience) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-[#FBFBFB] dark:bg-[#090D16] text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
