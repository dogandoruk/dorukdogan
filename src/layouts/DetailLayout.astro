---
import Layout from './Layout.astro';
import TechBadge from '../components/TechBadge.astro';
import MetricCard from '../components/MetricCard.astro';

interface KPI {
  label: string;
  value: string;
  sub?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  category: string;
  tag: string;
  role?: string;
  timeline?: string;
  tools: string[];
  kpis?: KPI[];
  backLink: string;
  backText: string;
}

const {
  title,
  subtitle,
  category,
  tag,
  role,
  timeline,
  tools,
  kpis,
  backLink,
  backText
} = Astro.props;

const tagBadgeClass = tag === 'Enterprise Growth'
  ? 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border-blue-200 dark:border-blue-800/60'
  : 'bg-purple-100 text-purple-800 dark:bg-purple-950/80 dark:text-purple-300 border-purple-200 dark:border-purple-800/60';
---

<Layout title={`${title} | Doruk Doğan`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Back button & category breadcrumb -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <a
        href={backLink}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors"
      >
        <span>←</span>
        <span>{backText}</span>
      </a>

      <div class="flex items-center gap-2">
        <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full border ${tagBadgeClass}`}>
          {tag}
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
          {category}
        </span>
      </div>
    </div>

    <!-- Title & Header -->
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
          {subtitle}
        </p>
      )}

      <!-- Metadata Strip (Role & Timeline) -->
      {(role || timeline) && (
        <div class="flex flex-wrap items-center gap-6 mt-6 pt-6 border-t border-slate-200 dark:border-slate-800 text-sm text-slate-600 dark:text-slate-400">
          {role && (
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">My Role</span>
              <span class="font-medium text-slate-900 dark:text-slate-200">{role}</span>
            </div>
          )}
          {timeline && (
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Timeline</span>
              <span class="font-medium text-slate-900 dark:text-slate-200">{timeline}</span>
            </div>
          )}
        </div>
      )}

      <!-- Tech stack badges -->
      {tools && tools.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {tools.map((t) => (
            <TechBadge name={t} />
          ))}
        </div>
      )}
    </header>

    <!-- Key Metrics Highlight Strip -->
    {kpis && kpis.length > 0 && (
      <div class="mb-12">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
          Key Performance Indicators
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          {kpis.map((kpi) => (
            <MetricCard value={kpi.value} label={kpi.label} subtext={kpi.sub} />
          ))}
        </div>
      </div>
    )}

    <!-- Main STAR Body Content -->
    <article class="prose prose-slate dark:prose-invert max-w-none">
      <slot />
    </article>

    <!-- Bottom Navigation / Next Steps -->
    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4">
      <a
        href={backLink}
        class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
      >
        <span>←</span>
        <span>{backText}</span>
      </a>

      <div class="flex items-center gap-3">
        <a
          href="mailto:dorukdogan95@gmail.com"
          class="px-4 py-2 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 rounded-lg text-xs font-semibold hover:opacity-90 transition-opacity"
        >
          Discuss this Project →
        </a>
      </div>
    </div>

  </div>
</Layout>
