---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800/80 bg-white/50 dark:bg-[#090d16]/50 py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Summary -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-bold text-sm">
            D
          </div>
          <span class="font-bold text-slate-900 dark:text-white">Doruk Doğan</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          Digital Marketing & Growth Specialist with a double major from Koç University and M.A. in New Media. Bridging enterprise marketing strategy (Rituals, Philips, Haleon) with custom AI tooling.
        </p>
        <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400 pt-2">
          <span>📍 Kadıköy, Istanbul</span>
          <span>•</span>
          <span>Open to Remote & Global Relocation</span>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          Navigation
        </h4>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Overview</a></li>
          <li><a href={`${base}/case-studies`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Enterprise Case Studies</a></li>
          <li><a href={`${base}/projects`} class="hover:text-slate-900 dark:hover:text-white transition-colors">AI & Builder Tools</a></li>
          <li><a href={`${base}/education`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Education & Research</a></li>
          <li><a href={`${base}/certifications`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Certifications</a></li>
        </ul>
      </div>

      <!-- Connect & Contact -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          Get in Touch
        </h4>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href="mailto:dorukdogan95@gmail.com" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              dorukdogan95@gmail.com
            </a>
          </li>
          <li>
            <a href="tel:+905322709723" class="hover:text-slate-900 dark:hover:text-white transition-colors">
              +90 532 270 9723
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/dorukdogan" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium">
              <span>LinkedIn Profile</span>
              <span>↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500 dark:text-slate-500">
      <div>
        © {currentYear} Doruk Doğan. Built with Astro & Tailwind CSS.
      </div>
      <div class="text-[11px] text-slate-400">
        Enterprise metrics normalized to preserve client confidentiality.
      </div>
    </div>
  </div>
</footer>
