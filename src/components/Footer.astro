---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-20 border-t border-slate-200/60 dark:border-slate-800/60 py-12 text-xs text-slate-500 dark:text-slate-400">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-6 pb-8 border-b border-slate-200/40 dark:border-slate-800/40">
      
      <div class="space-y-1 max-w-sm">
        <div class="font-bold text-slate-900 dark:text-white">Doruk Doğan</div>
        <p class="leading-relaxed">
          Performance Marketing &amp; Technical Web Operations Specialist. Enterprise performance media, technical SEO, and custom automation.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6 font-medium text-slate-700 dark:text-slate-300">
        <a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white">Home</a>
        <a href={`${base}/#case-studies` } class="hover:text-slate-900 dark:hover:text-white">Work</a>
        <a href={`${base}/#custom-tools`} class="hover:text-slate-900 dark:hover:text-white">Tools</a>
        <a href={`${base}/#experience`} class="hover:text-slate-900 dark:hover:text-white">Experience</a>
        <a href={`${base}/#qualifications`} class="hover:text-slate-900 dark:hover:text-white">Qualifications</a>
      </div>

    </div>

    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-slate-400">
      <div>
        &copy; {currentYear} Doruk Doğan. Built with Astro &amp; Tailwind CSS.
      </div>
      <div>
        Istanbul · dorukdogan95@gmail.com
      </div>
    </div>
  </div>
</footer>
