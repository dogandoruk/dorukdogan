---
export interface CaseStudyKpi {
  label: string;
  value: string;
  sub: string;
}

export interface EnrichedCaseStudy {
  slug: string;
  title: string;
  client: string;
  role: string;
  timeline: string;
  category: string;
  summary: string;
  kpis: CaseStudyKpi[];
  tools: string[];
  url: string;
  outboundUrl?: string;
  repoUrl?: string;
  image?: string;
  problem: string;
  strategy: string;
  impactSummary: string;
}

interface Props {
  work: EnrichedCaseStudy;
  index: number;
  defaultOpen?: boolean;
  base: string;
}

const { work, index, defaultOpen = false, base } = Astro.props;

const resolvedImage = work.image
  ? work.image.startsWith('/dorukdogan')
    ? work.image.replace('/dorukdogan', base)
    : `${base}${work.image}`
  : null;
---

<details
  name="editorial-case-studies"
  open={defaultOpen}
  class="group border-b border-slate-800/60 bg-transparent transition-colors py-4 first:pt-0"
>
  <summary class="list-none cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-emerald-500">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
      <div class="space-y-0.5 max-w-2xl">
        <div class="text-[11px] font-mono text-emerald-400">
          {work.client} · {work.category}
        </div>
        <h3 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors">
          {work.title}
        </h3>
        <p class="text-xs text-slate-400 line-clamp-1 leading-relaxed">
          {work.summary}
        </p>
      </div>

      <div class="flex items-center gap-2 pt-1 sm:pt-0 shrink-0">
        <span class="text-xs font-mono text-slate-500 group-open:text-emerald-400">
          <span class="group-open:hidden">+ Expand</span>
          <span class="hidden group-open:inline">− Close</span>
        </span>
      </div>
    </div>
  </summary>

  <!-- Condensed body: 1-sentence context, key metric, and action links -->
  <div class="pt-4 pb-2 space-y-4 text-xs text-slate-300">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
      
      <div class={resolvedImage ? "sm:col-span-8 space-y-3" : "sm:col-span-12 space-y-3"}>
        <p class="leading-relaxed">
          {work.problem} {work.strategy}
        </p>

        <!-- Metric highlights -->
        <div class="flex flex-wrap items-baseline gap-4 text-xs">
          {work.kpis.slice(0, 3).map((kpi) => (
            <div>
              <span class="font-mono font-bold text-white mr-1">{kpi.value}</span>
              <span class="text-slate-400">{kpi.label}</span>
            </div>
          ))}
        </div>

        <p class="text-emerald-300 font-medium">
          {work.impactSummary}
        </p>

        <!-- Action Links -->
        <div class="flex flex-wrap items-center gap-4 pt-1 font-semibold">
          <a
            href={`${base}${work.url}`}
            class="text-white hover:text-emerald-400 underline underline-offset-4"
          >
            Dedicated Case Study Page →
          </a>

          {work.outboundUrl && (
            <a
              href={work.outboundUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:text-emerald-300"
            >
              Live Project ↗
            </a>
          )}

          {work.repoUrl && (
            <a
              href={work.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white"
            >
              GitHub ↗
            </a>
          )}
        </div>
      </div>

      {resolvedImage && (
        <div class="sm:col-span-4">
          <img
            src={resolvedImage}
            alt={work.title}
            loading="lazy"
            class="w-full h-32 object-cover object-top rounded bg-slate-900"
          />
        </div>
      )}

    </div>
  </div>
</details>
