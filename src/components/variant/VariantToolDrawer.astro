---
export interface CustomProject {
  slug: string;
  title: string;
  type: string;
  tag: string;
  category: string;
  summary: string;
  kpis: { label: string; value: string; sub: string }[];
  tools: string[];
  featured: boolean;
  url: string;
  images?: { src: string; caption: string }[];
}

interface Props {
  project: CustomProject;
  index: number;
  defaultOpen?: boolean;
  base: string;
}

const { project, index, defaultOpen = false, base } = Astro.props;
const images = project.images || [];

const toolBriefs: Record<string, string> = {
  'job-application-filler': 'Unified career intake dashboard consolidating job boards with real-time match scoring and custom CV exports.',
  'la-by-night': 'VTM campaign management suite with FastAPI, interactive Leaflet GIS territory maps, and 800+ node lore codex.',
  'cooking-companion': 'Smart kitchen inventory with on-device Google ML Kit receipt OCR and TSE produce weight conversions.',
  'catspotting': 'Native Android app with Google Gemini 2.5 Flash Vision AI to classify coat traits and track community cats on maps.',
  'monday-mage': 'Automated rulebook OCR extraction pipeline converting multi-volume PDFs into an offline-first search dashboard.'
};

const brief = toolBriefs[project.slug] || project.summary;
---

<details
  name="variant-custom-tools"
  open={defaultOpen}
  class="group border-b border-slate-800/60 bg-transparent transition-colors py-4 first:pt-0"
  data-tool-slug={project.slug}
>
  <summary class="list-none cursor-pointer select-none focus-visible:outline-2 focus-visible:outline-emerald-500">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
      <div class="space-y-0.5 max-w-2xl">
        <div class="text-[11px] font-mono text-cyan-400">
          {project.category} · {project.type}
        </div>
        <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">
          {project.title}
        </h3>
        <p class="text-xs text-slate-400 line-clamp-1 leading-relaxed">
          {brief}
        </p>
      </div>

      <div class="flex items-center gap-2 pt-1 sm:pt-0 shrink-0">
        <span class="text-xs font-mono text-slate-500 group-open:text-cyan-400">
          <span class="group-open:hidden">+ Expand</span>
          <span class="hidden group-open:inline">− Close</span>
        </span>
      </div>
    </div>
  </summary>

  <div class="pt-4 pb-2 space-y-4 text-xs text-slate-300">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
      
      <!-- Narrative Details & Metrics (7 Cols) -->
      <div class="sm:col-span-7 space-y-3">
        <p class="leading-relaxed">
          {project.summary}
        </p>

        <!-- Metrics -->
        <div class="flex flex-wrap items-baseline gap-4 text-xs">
          {project.kpis.slice(0, 3).map((kpi) => (
            <div>
              <span class="font-mono font-bold text-white mr-1">{kpi.value}</span>
              <span class="text-slate-400">{kpi.label}</span>
            </div>
          ))}
        </div>

        <!-- Action Links -->
        <div class="flex items-center gap-4 pt-1 font-semibold">
          <a
            href={`${base}${project.url}`}
            class="text-white hover:text-cyan-300 underline underline-offset-4"
          >
            System Architecture →
          </a>

          {project.slug === 'la-by-night' && (
            <a
              href="https://evatium.github.io/la-by-night/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyan-400 hover:text-cyan-300"
            >
              Live Codex ↗
            </a>
          )}
        </div>
      </div>

      <!-- Screenshot Gallery & Clickable Thumbnails (5 Cols) -->
      {images.length > 0 && (
        <div class="sm:col-span-5 space-y-2 tool-gallery">
          <div class="overflow-hidden rounded bg-slate-900">
            <img
              src={`${base}${images[0].src}`}
              alt={images[0].caption}
              loading="lazy"
              class="main-preview-img w-full h-36 object-cover object-top transition-all duration-200"
            />
            <div class="px-2 py-1 text-[10px] font-mono text-slate-400 truncate caption-text">
              {images[0].caption}
            </div>
          </div>

          <!-- Clickable Thumbnail Preview Strip -->
          {images.length > 1 && (
            <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
              {images.map((img) => (
                <button
                  type="button"
                  class="thumb-btn relative rounded overflow-hidden border border-slate-800 hover:border-cyan-400 focus:outline-hidden transition-all shrink-0 cursor-pointer"
                  data-full-src={`${base}${img.src}`}
                  data-caption={img.caption}
                  title={img.caption}
                >
                  <img
                    src={`${base}${img.src}`}
                    alt={img.caption}
                    class="w-12 h-9 object-cover object-top opacity-60 hover:opacity-100 transition-opacity"
                  />
                </button>
              ))}
            </div>
          )}
        </div>
      )}

    </div>
  </div>
</details>

<script is:inline>
  document.querySelectorAll('.tool-gallery').forEach((gallery) => {
    const mainImg = gallery.querySelector('.main-preview-img');
    const captionEl = gallery.querySelector('.caption-text');
    const thumbs = gallery.querySelectorAll('.thumb-btn');

    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const fullSrc = btn.getAttribute('data-full-src');
        const caption = btn.getAttribute('data-caption');
        if (mainImg && fullSrc) {
          mainImg.setAttribute('src', fullSrc);
        }
        if (captionEl && caption) {
          captionEl.textContent = caption;
        }
        thumbs.forEach(b => b.classList.remove('border-cyan-400'));
        btn.classList.add('border-cyan-400');
      });
    });
  });
</script>
