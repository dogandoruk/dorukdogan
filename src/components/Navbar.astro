---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { name: 'Work', href: `${base}/#case-studies` },
  { name: 'Tools', href: `${base}/#custom-tools` },
  { name: 'Experience', href: `${base}/#experience` },
  { name: 'Qualifications', href: `${base}/#qualifications` },
  { name: 'Contact', href: `${base}/#contact` },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/85 dark:bg-[#0B0F19]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-black text-base shadow-sm group-hover:scale-105 transition-transform">
          D
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-slate-900 dark:text-white text-sm sm:text-base leading-tight group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            Doruk Doğan
          </span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium leading-none">
            Performance Marketing & Web Operations
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== `${base}/` && !link.href.includes('#') && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold'
                  : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions: Theme Toggle & Direct Contact -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <ThemeToggle />
        
        <a
          href={`${base}/#contact`}
          class="hidden sm:inline-flex items-center px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-slate-950 text-xs font-semibold shadow-sm transition-all hover:scale-[1.02]"
        >
          Contact
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0B0F19] px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-lg text-base font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-2 mt-2 border-t border-slate-100 dark:border-slate-800">
      <a
        href={`${base}/#contact`}
        class="block text-center px-3 py-2 rounded-lg bg-emerald-600 text-white dark:bg-emerald-500 dark:text-slate-950 text-xs font-semibold"
      >
        Contact
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.toggle('hidden');
      mobileBtn.setAttribute('aria-expanded', String(!isHidden));
    });
  }
</script>
