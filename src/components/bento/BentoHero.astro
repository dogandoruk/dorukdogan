---
import cvData from '../../data/cv.json';

const { basics } = cvData;
---

<section class="pt-6 pb-8 sm:pt-10 sm:pb-10 border-b border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-3xl space-y-3">
    
    <!-- Name -->
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
      {basics.name}
    </h1>

    <!-- 1-Sentence High-Impact Positioning -->
    <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
      Performance marketing and technical web operations specialist scaling commercial growth for enterprise brands (<span class="text-slate-900 dark:text-white font-semibold">Rituals, Philips, NMQ Digital</span>) across 16+ European markets and engineering custom automation software.
    </p>

  </div>
</section>
