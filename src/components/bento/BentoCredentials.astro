---
import certsData from '../../data/certifications.json';
import educationData from '../../data/education.json';

// Group certifications cleanly by category
const seoCerts = certsData.filter(c => c.category === 'SEO & Content');
const aiCerts = certsData.filter(c => c.category === 'AI & Search');
const perfCerts = certsData.filter(c => c.category === 'Performance Marketing & Paid Ads');
const uxCerts = certsData.filter(c => c.category === 'UX & Automation');
const socialCerts = certsData.filter(c => c.category === 'Social & Media');
const maritimeCerts = certsData.filter(c => c.category === 'Maritime and Commercial Licensing');
---

<section id="qualifications" class="py-12 sm:py-16 border-b border-slate-200/60 dark:border-slate-800/60 scroll-mt-16">
  <div class="space-y-8">
    
    <!-- Section Header (Zero filler text) -->
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Qualifications
      </h2>
      <span class="text-xs font-mono text-slate-400">
        3 Degrees · 21 Verified Credentials
      </span>
    </div>

    <!-- Balanced 2-Column Categorized Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-12 text-sm">
      
      <!-- COLUMN 1: Academic Foundation + Technical SEO & AI Search -->
      <div class="space-y-8">
        
        <!-- Academic Foundation -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            Academic Foundation
          </div>
          <div class="space-y-4">
            {educationData.map((edu) => (
              <div class="space-y-0.5">
                <div class="font-bold text-slate-900 dark:text-white text-base">
                  {edu.degree}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs flex items-center gap-1.5">
                  <span>{edu.institution}</span>
                  <span>·</span>
                  <span>{edu.year}</span>
                </div>
                {edu.highlight && (
                  <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm leading-relaxed pt-0.5">
                    {edu.highlight}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Technical SEO & Search Strategy -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            Technical SEO & Search Strategy ({seoCerts.length})
          </div>
          <div class="space-y-3">
            {seoCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- AI & Intelligent Search -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            AI & Intelligent Systems ({aiCerts.length})
          </div>
          <div class="space-y-3">
            {aiCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- COLUMN 2: Performance Marketing, UX/Automation, Social & Maritime -->
      <div class="space-y-8">
        
        <!-- Performance Marketing & Paid Ads -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            Performance Marketing & Paid Ads ({perfCerts.length})
          </div>
          <div class="space-y-3">
            {perfCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- UX Design & Process Automation -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            UX Design & Automation ({uxCerts.length})
          </div>
          <div class="space-y-3">
            {uxCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Social & Media Strategy -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            Content & Media Strategy ({socialCerts.length})
          </div>
          <div class="space-y-3">
            {socialCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Commercial & Maritime Licensing -->
        <div class="space-y-4">
          <div class="font-mono text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider text-xs pb-1 border-b border-slate-200/50 dark:border-slate-800/50">
            Maritime & Commercial Licensing ({maritimeCerts.length})
          </div>
          <div class="space-y-3">
            {maritimeCerts.map((cert) => (
              <div class="space-y-0.5">
                <div class="font-semibold text-slate-900 dark:text-white text-sm">
                  {cert.name}
                </div>
                <div class="text-slate-500 dark:text-slate-400 font-mono text-xs">
                  {cert.issuer} · {cert.date}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
