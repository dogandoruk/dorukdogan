---
import cvData from '../../data/cv.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="experience" class="py-12 sm:py-16 border-b border-slate-200/60 dark:border-slate-800/60 scroll-mt-16">
  <div class="space-y-8">
    
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Experience
      </h2>
      <a
        href={`${base}/Doruk_Dogan_CV.pdf`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 underline underline-offset-4"
      >
        CV (PDF)
      </a>
    </div>

    <!-- Clean Timeline Ledger: Role · Company · Dates · Crisp Highlights -->
    <div class="divide-y divide-slate-200/50 dark:divide-slate-800/50">
      {cvData.experience.map((exp) => (
        <div class="py-6 first:pt-0 last:pb-0 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">{exp.role}</span>
              <span class="text-slate-400 mx-1.5">·</span>
              <span class="text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400">{exp.company}</span>
            </div>
            <span class="font-mono text-xs text-slate-400 shrink-0">
              {exp.period}
            </span>
          </div>
          {exp.highlights && exp.highlights.length > 0 && (
            <ul class="space-y-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl pt-1">
              {exp.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <span class="text-slate-400 shrink-0 mt-0.5">•</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

  </div>
</section>
