---
const metrics = [
  { value: '16+', label: 'EU Markets Managed' },
  { value: '€75k/mo', label: 'Peak Media Spend' },
  { value: '100+', label: 'Enterprise SEO Audits' },
  { value: '5 Tools', label: 'Custom Systems Built' },
];
---

<section class="py-8 border-b border-slate-200/60 dark:border-slate-800/60">
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
    {metrics.map((m) => (
      <div>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono tracking-tight">
          {m.value}
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          {m.label}
        </div>
      </div>
    ))}
  </div>
</section>
