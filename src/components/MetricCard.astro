---
interface Props {
  value: string;
  label: string;
  subtext?: string;
  trend?: string;
}

const { value, label, subtext, trend } = Astro.props;
---

<div class="bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between">
  <div class="flex items-baseline justify-between gap-2">
    <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white code-font">
      {value}
    </div>
    {trend && (
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        {trend}
      </span>
    )}
  </div>
  <div class="mt-2">
    <div class="text-sm font-semibold text-slate-800 dark:text-slate-200">
      {label}
    </div>
    {subtext && (
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        {subtext}
      </div>
    )}
  </div>
</div>
