---
import TechBadge from './TechBadge.astro';

interface KPI {
  label: string;
  value: string;
  sub?: string;
}

interface Props {
  title: string;
  summary: string;
  category: string;
  tag: string;
  tools: string[];
  kpis?: KPI[];
  url: string;
  type?: string;
}

const { title, summary, category, tag, tools, kpis, url, type } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formattedUrl = url.startsWith('http') ? url : (url.startsWith('/') ? `${base}${url}` : `${base}/${url}`);

const tagBadgeClass = tag === 'Enterprise Growth'
  ? 'bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border-blue-200 dark:border-blue-800/60'
  : 'bg-purple-100 text-purple-800 dark:bg-purple-950/80 dark:text-purple-300 border-purple-200 dark:border-purple-800/60';
---

<div class="group relative bg-white dark:bg-[#0f172a] border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 rounded-2xl p-6 sm:p-7 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <!-- Top Metadata -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${tagBadgeClass}`}>
        {tag}
      </span>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
        {category}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
      <a href={formattedUrl} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3 mb-5 leading-relaxed">
      {summary}
    </p>

    <!-- Highlight Metrics -->
    {kpis && kpis.length > 0 && (
      <div class="grid grid-cols-2 gap-2.5 py-3 px-3.5 bg-slate-50 dark:bg-slate-900/60 rounded-xl border border-slate-100 dark:border-slate-800/80 mb-5">
        {kpis.slice(0, 2).map((kpi) => (
          <div>
            <div class="text-lg font-bold text-slate-900 dark:text-white code-font">{kpi.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{kpi.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <div>
    <!-- Tools -->
    <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-100 dark:border-slate-800/80">
      {tools.slice(0, 4).map((tool) => (
        <TechBadge name={tool} />
      ))}
      {tools.length > 4 && (
        <span class="text-xs text-slate-500 dark:text-slate-400 self-center">+{tools.length - 4}</span>
      )}
    </div>

    <div class="mt-4 flex items-center justify-between text-xs font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">
      <span>Read Case Study</span>
      <span>→</span>
    </div>
  </div>
</div>
